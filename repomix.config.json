{
  "$schema": "https://raw.githubusercontent.com/yamadashy/repomix/main/repomix.schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "topFilesLength": 10
  },
  "include": [
    "src/**/*.{ts,tsx,css}",
    "context.md",
    "features_implemented.md",
    "tracker.md",
    "package.json",
    "components.json",
    "next.config.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      ".next/**",
      ".git/**",
      "repomix-output.*",
      "package-lock.json",
      "**/*.log"
    ]
  }
}

