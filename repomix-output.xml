<file path="src/components/3d/EventScene.tsx">
  1: "use client";
  2: 
  3: import React, { useEffect, useRef } from "react";
  4: import * as THREE from "three";
  5: 
  6: interface EventSceneProps {
  7:   className?: string;
  8: }
  9: 
 10: export default function EventScene({ className }: EventSceneProps) {
 11:   const containerRef = useRef<HTMLDivElement>(null);
 12: 
 13:   useEffect(() => {
 14:     const container = containerRef.current;
 15:     if (!container) return;
 16: 
 17:     // 1. Scene, Camera & Renderer
 18:     const scene = new THREE.Scene();
 19: 
 20:     const camera = new THREE.PerspectiveCamera(
 21:       45,
 22:       container.clientWidth / container.clientHeight,
 23:       0.1,
 24:       100
 25:     );
 26:     camera.position.set(0, 0, 8);
 27: 
 28:     const renderer = new THREE.WebGLRenderer({
 29:       antialias: true,
 30:       alpha: true,
 31:       powerPreference: "high-performance",
 32:     });
 33:     renderer.setSize(container.clientWidth, container.clientHeight);
 34:     renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
 35:     renderer.toneMapping = THREE.ACESFilmicToneMapping;
 36:     renderer.toneMappingExposure = 1.2;
 37:     renderer.shadowMap.enabled = true;
 38:     renderer.shadowMap.type = THREE.PCFSoftShadowMap;
 39: 
 40:     container.appendChild(renderer.domElement);
 41: 
 42:     // 2. Lighting Setup
 43:     const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
 44:     scene.add(ambientLight);
 45: 
 46:     const blueLight = new THREE.PointLight(0x3b82f6, 40, 20);
 47:     blueLight.position.set(-4, 3, 4);
 48:     scene.add(blueLight);
 49: 
 50:     const cyanLight = new THREE.PointLight(0x06b6d4, 35, 20);
 51:     cyanLight.position.set(4, -3, 3);
 52:     scene.add(cyanLight);
 53: 
 54:     const purpleLight = new THREE.DirectionalLight(0xa855f7, 2);
 55:     purpleLight.position.set(0, 6, 2);
 56:     scene.add(purpleLight);
 57: 
 58:     // 3. 3D Deck of Cards Group
 59:     const cardGroup = new THREE.Group();
 60:     scene.add(cardGroup);
 61: 
 62:     // Card dimensions
 63:     const cardWidth = 1.8;
 64:     const cardHeight = 2.6;
 65:     const cardDepth = 0.04;
 66:     const cardGeometry = new THREE.BoxGeometry(cardWidth, cardHeight, cardDepth);
 67: 
 68:     // Materials
 69:     const cardColors = [0x1e293b, 0x0f172a, 0x1e1b4b, 0x312e81, 0x0284c7];
 70:     const cardCount = 7;
 71:     const cards: THREE.Mesh[] = [];
 72: 
 73:     for (let i = 0; i < cardCount; i++) {
 74:       const material = new THREE.MeshPhysicalMaterial({
 75:         color: cardColors[i % cardColors.length],
 76:         metalness: 0.7,
 77:         roughness: 0.2,
 78:         clearcoat: 0.8,
 79:         clearcoatRoughness: 0.1,
 80:         reflectivity: 0.9,
 81:       });
 82: 
 83:       const mesh = new THREE.Mesh(cardGeometry, material);
 84:       
 85:       // Fan arrangement (Deck of cards)
 86:       const angle = (i - (cardCount - 1) / 2) * 0.14;
 87:       mesh.position.x = Math.sin(angle) * 2.2;
 88:       mesh.position.y = -Math.abs(angle) * 0.8;
 89:       mesh.position.z = -i * 0.12;
 90:       mesh.rotation.z = -angle * 0.8;
 91:       mesh.rotation.y = angle * 0.5;
 92: 
 93:       // Add a glowing holographic border edge
 94:       const edges = new THREE.EdgesGeometry(cardGeometry);
 95:       const edgeMaterial = new THREE.LineBasicMaterial({
 96:         color: i % 2 === 0 ? 0x00f0ff : 0xa855f7,
 97:         linewidth: 2,
 98:       });
 99:       const edgeLines = new THREE.LineSegments(edges, edgeMaterial);
100:       mesh.add(edgeLines);
101: 
102:       cardGroup.add(mesh);
103:       cards.push(mesh);
104:     }
105: 
106:     // 4. Stardust / Floating Particle Nebula
107:     const particleCount = 600;
108:     const particleGeometry = new THREE.BufferGeometry();
109:     const positions = new Float32Array(particleCount * 3);
110:     const colors = new Float32Array(particleCount * 3);
111: 
112:     for (let i = 0; i < particleCount * 3; i += 3) {
113:       positions[i] = (Math.random() - 0.5) * 16;
114:       positions[i + 1] = (Math.random() - 0.5) * 16;
115:       positions[i + 2] = (Math.random() - 0.5) * 12;
116: 
117:       // Cosmic blue & cyan & violet hues
118:       const choice = Math.random();
119:       if (choice < 0.4) {
120:         colors[i] = 0.23; colors[i + 1] = 0.51; colors[i + 2] = 0.96; // Blue
121:       } else if (choice < 0.7) {
122:         colors[i] = 0.02; colors[i + 1] = 0.71; colors[i + 2] = 0.83; // Cyan
123:       } else {
124:         colors[i] = 0.66; colors[i + 1] = 0.33; colors[i + 2] = 0.97; // Violet
125:       }
126:     }
127: 
128:     particleGeometry.setAttribute(
129:       "position",
130:       new THREE.BufferAttribute(positions, 3)
131:     );
132:     particleGeometry.setAttribute(
133:       "color",
134:       new THREE.BufferAttribute(colors, 3)
135:     );
136: 
137:     const particleMaterial = new THREE.PointsMaterial({
138:       size: 0.045,
139:       vertexColors: true,
140:       transparent: true,
141:       opacity: 0.75,
142:       blending: THREE.AdditiveBlending,
143:     });
144: 
145:     const particles = new THREE.Points(particleGeometry, particleMaterial);
146:     scene.add(particles);
147: 
148:     // 5. Interactive Mouse Parallax
149:     let mouseX = 0;
150:     let mouseY = 0;
151:     let targetX = 0;
152:     let targetY = 0;
153: 
154:     const handleMouseMove = (event: MouseEvent) => {
155:       mouseX = (event.clientX / window.innerWidth) * 2 - 1;
156:       mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
157:     };
158: 
159:     window.addEventListener("mousemove", handleMouseMove, { passive: true });
160: 
161:     // 6. Responsive Resize Handler
162:     const handleResize = () => {
163:       if (!container) return;
164:       const width = container.clientWidth;
165:       const height = container.clientHeight;
166: 
167:       camera.aspect = width / height;
168:       camera.updateProjectionMatrix();
169: 
170:       renderer.setSize(width, height);
171:       renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
172:     };
173: 
174:     window.addEventListener("resize", handleResize);
175: 
176:     // 7. Render Loop with Smooth Damping
177:     let animationFrameId: number;
178:     const startTime = performance.now();
179: 
180:     const render = () => {
181:       const elapsedTime = (performance.now() - startTime) / 1000;
182: 
183:       // Smooth mouse interpolation
184:       targetX += (mouseX - targetX) * 0.05;
185:       targetY += (mouseY - targetY) * 0.05;
186: 
187:       // Card group floating motion + mouse response
188:       cardGroup.rotation.y = Math.sin(elapsedTime * 0.6) * 0.15 + targetX * 0.35;
189:       cardGroup.rotation.x = Math.cos(elapsedTime * 0.5) * 0.1 - targetY * 0.25;
190:       cardGroup.position.y = Math.sin(elapsedTime * 1.2) * 0.15;
191: 
192:       // Subtle breathing animation on individual cards
193:       cards.forEach((card, idx) => {
194:         card.position.y += Math.sin(elapsedTime * 1.5 + idx) * 0.0015;
195:       });
196: 
197:       // Slowly rotate particle field
198:       particles.rotation.y = elapsedTime * 0.03;
199:       particles.rotation.x = elapsedTime * 0.015;
200: 
201:       renderer.render(scene, camera);
202:       animationFrameId = requestAnimationFrame(render);
203:     };
204: 
205:     render();
206: 
207:     // 8. Strict GPU Resource Disposal
208:     return () => {
209:       cancelAnimationFrame(animationFrameId);
210:       window.removeEventListener("mousemove", handleMouseMove);
211:       window.removeEventListener("resize", handleResize);
212: 
213:       // Clean scene graph
214:       cardGeometry.dispose();
215:       particleGeometry.dispose();
216:       particleMaterial.dispose();
217: 
218:       cards.forEach((card) => {
219:         if (Array.isArray(card.material)) {
220:           card.material.forEach((m) => m.dispose());
221:         } else {
222:           card.material.dispose();
223:         }
224:       });
225: 
226:       renderer.dispose();
227:       if (container.contains(renderer.domElement)) {
228:         container.removeChild(renderer.domElement);
229:       }
230:     };
231:   }, []);
232: 
233:   return (
234:     <div
235:       ref={containerRef}
236:       className={className || "webgl-canvas-container"}
237:       style={{ overflow: "hidden" }}
238:     />
239:   );
240: }
