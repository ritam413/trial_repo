<file path="src/components/event/Countdown.tsx">
 1: "use client";
 2: 
 3: import React, { useState, useEffect } from "react";
 4: 
 5: interface TimeLeft {
 6:   days: number;
 7:   hours: number;
 8:   minutes: number;
 9:   seconds: number;
10: }
11: 
12: export default function Countdown() {
13:   const [timeLeft, setTimeLeft] = useState<TimeLeft>({
14:     days: 120,
15:     hours: 14,
16:     minutes: 36,
17:     seconds: 42,
18:   });
19: 
20:   useEffect(() => {
21:     // Target event date: Deck of Cards 2026 Showcase
22:     const targetDate = new Date("2026-10-24T00:00:00Z").getTime();
23: 
24:     const interval = setInterval(() => {
25:       const now = new Date().getTime();
26:       const difference = targetDate - now;
27: 
28:       if (difference <= 0) {
29:         clearInterval(interval);
30:         return;
31:       }
32: 
33:       setTimeLeft({
34:         days: Math.floor(difference / (1000 * 60 * 60 * 24)),
35:         hours: Math.floor((difference / (1000 * 60 * 60)) % 24),
36:         minutes: Math.floor((difference / 1000 / 60) % 60),
37:         seconds: Math.floor((difference / 1000) % 60),
38:       });
39:     }, 1000);
40: 
41:     return () => clearInterval(interval);
42:   }, []);
43: 
44:   const timeBlocks = [
45:     { label: "DAYS", value: timeLeft.days },
46:     { label: "HOURS", value: timeLeft.hours },
47:     { label: "MINUTES", value: timeLeft.minutes },
48:     { label: "SECONDS", value: timeLeft.seconds },
49:   ];
50: 
51:   return (
52:     <div className="flex flex-wrap items-center justify-center gap-3 sm:gap-5 my-8">
53:       {timeBlocks.map((block) => (
54:         <div
55:           key={block.label}
56:           className="flex flex-col items-center justify-center w-20 h-22 sm:w-26 sm:h-28 rounded-xl bg-slate-900/80 border border-slate-800/90 shadow-[0_8px_30px_rgb(0,0,0,0.5)] backdrop-blur-md"
57:         >
58:           <span className="text-2xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-b from-white to-slate-400 bg-clip-text text-transparent font-mono">
59:             {String(block.value).padStart(2, "0")}
60:           </span>
61:           <span className="text-[10px] sm:text-xs font-semibold tracking-widest text-cyan-400/90 mt-1 uppercase">
62:             {block.label}
63:           </span>
64:         </div>
65:       ))}
66:     </div>
67:   );
68: }
</file>

