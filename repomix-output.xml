 20: /**
 21:  * Smoothly scrolls the window to a given anchor or element using GSAP
 22:  * Speed is governed by SMOOTH_SCROLL_CONFIG.duration
 23:  */
 24: export function gsapScrollTo(
 25:   target: string | HTMLElement | number,
 26:   duration = SMOOTH_SCROLL_CONFIG.duration,
 27:   offset = SMOOTH_SCROLL_CONFIG.offset
 28: ) {
 29:   if (typeof window === "undefined") return;
 30: 
 31:   let targetY = 0;
 32:   if (typeof target === "number") {
 33:     targetY = target;
 34:   } else {
 35:     const el = typeof target === "string" ? document.querySelector(target) : target;
 36:     if (!el) return;
 37:     const rect = el.getBoundingClientRect();
 38:     targetY = window.scrollY + rect.top + offset;
 39:   }
 40: 
 41:   const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
 42:   targetY = Math.max(0, Math.min(targetY, maxScroll));
 43: 
 44:   // If scrolling back to top (#hero), notify HeroSection to replay opening cycle
 45:   if (target === "#hero" || targetY <= 20) {
 46:     window.dispatchEvent(new CustomEvent("hero:restart-loop", { detail: { resetIntro: true } }));
 47:   }
 48: 
 49:   const scrollObj = { y: window.scrollY };
 50:   gsap.killTweensOf(scrollObj);
 51:   gsap.to(scrollObj, {
 52:     y: targetY,
 53:     duration,
 54:     ease: SMOOTH_SCROLL_CONFIG.ease,
 55:     onUpdate: () => {
 56:       window.scrollTo(0, scrollObj.y);
 57:     },
 58:   });
 59: }
