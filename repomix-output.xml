 363:             <Icon.Shuffle className="w-3.5 h-3.5 text-[#FFAA24] shrink-0" />
 364:             <span>Shuffle</span>
 365:           </button>
 366: 
 367:           <button
 368:             type="button"
 369:             onClick={onDrawFortune}
 370:             className="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-gradient-to-r from-[#8B1E24] to-[#E65C19] hover:brightness-110 text-[#FFF4E0] border border-[#FFAA24] text-xs font-bold tracking-wider uppercase shadow-[0_0_24px_rgba(230,92,25,0.45)] transition-all active:scale-95 cursor-pointer"
 371:           >
 372:             <Icon.Sparkles className="w-3.5 h-3.5 text-[#FFAA24] shrink-0" />
