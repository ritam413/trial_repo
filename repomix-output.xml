248: /* ==========================================================================
249:    4. SYNTHESIZED TACTILE CARD AUDIO HELPER (ZERO EXTERNAL ASSETS)
250:    ========================================================================== */
251: function playCardTactileSound(type: "deal" | "flip" = "deal") {
252:   if (typeof window === "undefined") return;
253:   try {
254:     const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
255:     if (!AudioCtx) return;
256:     const ctx = new AudioCtx();
257:     const osc = ctx.createOscillator();
258:     const gain = ctx.createGain();
259: 
260:     if (type === "deal") {
261:       osc.type = "sine";
262:       osc.frequency.setValueAtTime(320, ctx.currentTime);
263:       osc.frequency.exponentialRampToValueAtTime(120, ctx.currentTime + 0.08);
264:       gain.gain.setValueAtTime(0.08, ctx.currentTime);
265:       gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
266:       osc.connect(gain);
267:       gain.connect(ctx.destination);
268:       osc.start();
269:       osc.stop(ctx.currentTime + 0.08);
270:     } else {
271:       osc.type = "triangle";
272:       osc.frequency.setValueAtTime(440, ctx.currentTime);
273:       osc.frequency.exponentialRampToValueAtTime(220, ctx.currentTime + 0.12);
274:       gain.gain.setValueAtTime(0.1, ctx.currentTime);
275:       gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
276:       osc.connect(gain);
277:       gain.connect(ctx.destination);
278:       osc.start();
279:       osc.stop(ctx.currentTime + 0.12);
280:     }
281:   } catch {
282:     // AudioContext blocked or not allowed by browser policy; silent fallback
283:   }
284: }
