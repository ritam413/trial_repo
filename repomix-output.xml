487:    ========================================================================== */
488: export default function CoreMembersSection() {
489:   const containerRef = useRef<HTMLDivElement>(null);
490:   const [activeFilter, setActiveFilter] = useState<string>("all");
491:   const [dealCount, setDealCount] = useState<number>(1);
492: 
493:   // Filter Categories
494:   const categories = [
495:     { id: "all", label: "ALL ARCHITECTS (6)" },
496:     { id: "crimson-vanguard", label: "CRIMSON VANGUARD" },
497:     { id: "checkered-sovereign", label: "CHECKERED SOVEREIGN" },
498:     { id: "cyber-horizon", label: "CYBER HORIZON" },
499:   ];
500: 
501:   const filteredMembers = activeFilter === "all"
502:     ? CORE_MEMBERS
503:     : CORE_MEMBERS.filter((m) => m.designVariant === activeFilter);
504: 
505:   // GSAP SCROLLTRIGGER ANIMATION:
506:   // EACH CARD triggers its OWN side-entrance animation as it scrolls into view!
507:   // Even cards fly in from the left (-280px), odd cards fly in from the right (+280px)
508:   useGSAP(
509:     () => {
510:       const cards = gsap.utils.toArray<HTMLElement>(".core-card-wrapper");
511:       if (!cards.length) return;
512: 
513:       // 1. Header elements entrance
514:       gsap.from(".core-anim-header", {
515:         scrollTrigger: {
516:           trigger: containerRef.current,
517:           start: "top 85%",
518:           toggleActions: "play none none reverse",
519:         },
520:         y: 28,
521:         autoAlpha: 0,
522:         stagger: 0.1,
523:         duration: 0.7,
524:         ease: "power3.out",
525:       });
526: 
527:       // 2. Individual Card Side Entrance on Viewport Entry:
528:       // Every single card has its own ScrollTrigger so as you scroll down,
529:       // all cards (cards 0, 1, 2, 3, 4, 5) dramatically sweep in from the sides!
530:       cards.forEach((card, i) => {
531:         const isFromLeft = i % 2 === 0;
532:         gsap.fromTo(
533:           card,
534:           {
535:             x: isFromLeft ? -300 : 300,
536:             y: 45,
537:             rotationZ: isFromLeft ? -16 : 16,
538:             rotationY: isFromLeft ? 28 : -28,
539:             scale: 0.8,
540:             autoAlpha: 0,
541:           },
542:           {
543:             x: 0,
544:             y: 0,
545:             rotationZ: 0,
546:             rotationY: 0,
547:             scale: 1,
548:             autoAlpha: 1,
549:             duration: 0.9,
550:             ease: "power3.out",
551:             clearProps: "transform",
552:             scrollTrigger: {
553:               trigger: card,
554:               start: "top 88%",
555:               end: "bottom 15%",
556:               toggleActions: "play none none reverse",
557:             },
558:           }
559:         );
560:       });
561:     },
562:     { scope: containerRef, dependencies: [activeFilter] }
563:   );
564: 
565:   // INTERACTIVE RE-DEAL FUNCTIONALITY:
566:   // Allows user to re-trigger the side card dealing animation on demand
567:   const handleReDeal = useCallback(() => {
568:     playCardTactileSound("deal");
569:     setDealCount((c) => c + 1);
570: 
571:     const cards = gsap.utils.toArray<HTMLElement>(".core-card-wrapper");
572:     if (!cards.length) return;
573: 
574:     gsap.killTweensOf(cards);
575: 
576:     gsap.fromTo(
577:       cards,
578:       {
579:         x: (i) => (i % 2 === 0 ? -260 : 260),
580:         y: (i) => 50 + (i % 3) * 20,
581:         rotationZ: (i) => (i % 2 === 0 ? -18 : 18),
582:         rotationY: (i) => (i % 2 === 0 ? 30 : -30),
583:         scale: 0.78,
584:         autoAlpha: 0,
585:       },
586:       {
587:         x: 0,
588:         y: 0,
589:         rotationZ: 0,
590:         rotationY: 0,
591:         scale: 1,
592:         autoAlpha: 1,
593:         duration: 0.9,
594:         stagger: {
595:           amount: 0.45,
596:           from: "start",
597:         },
598:         ease: "power3.out",
599:         clearProps: "transform",
600:       }
601:     );
602:   }, []);
603: 
604:   return (
605:     <section
606:       id="core-members"
607:       ref={containerRef}
608:       className="relative py-20 sm:py-28 overflow-hidden z-10 bg-[#120E15] border-b border-[#8B1E24]/40"
609:     >
610:       {/* 3D Ambient Studio Grid Background (Same as Gallery Section) */}
611:       <div
612:         aria-hidden="true"
613:         className="absolute inset-0 pointer-events-none opacity-[0.06]"
614:         style={{
615:           backgroundImage: `radial-gradient(#FFAA24 1px, transparent 1px)`,
616:           backgroundSize: "28px 28px",
617:         }}
618:       />
619: 
620:       {/* Background Ambient Glow Plinth */}
621:       <div
622:         aria-hidden="true"
623:         className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[450px] bg-gradient-to-r from-[#8B1E24]/15 via-[#FFAA24]/10 to-transparent blur-[120px] pointer-events-none"
624:       />
625: 
626:       <div className="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
627: 
628:       {/* Section Header with Swiss Architectural Typography */}
629:       <div className="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-16">
630:         <div className="max-w-2xl">
631:           <h2 className="core-anim-header font-display text-4xl sm:text-6xl lg:text-7xl text-[#FFF4E0] leading-none uppercase tracking-tight">
632:             NEW CORE <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#FFAA24] via-[#E65C19] to-[#FFF4E0]">MEMBERS</span>
633:           </h2>
