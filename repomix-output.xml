587:               onClick={(e) => e.stopPropagation()}
588:               className="relative w-full max-w-4xl rounded-3xl overflow-hidden bg-[#18121D] border-2 border-[#FFAA24] shadow-[0_24px_80px_rgba(0,0,0,0.85)]"
589:             >
