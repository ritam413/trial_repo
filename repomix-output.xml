 295: /* ==========================================================================
 296:    4. FORMATION MATH
 297:    ========================================================================== */
 298: interface CardTransform {
 299:   x: number;
 300:   y: number;
 301:   z: number;
 302:   rotX: number;
 303:   rotY: number;
 304:   rotZ: number;
 305:   scale: number;
 306: }
 307: 
 308: function getFormationTransform(
 309:   formIdx: number,
 310:   i: number,
 311:   elapsed: number,
 312:   card: { corridorPos: THREE.Vector3; corridorRotY: number; corridorScale: number; phase: number },
 313:   norm: number,
 314:   mobileNow: boolean,
 315:   burst: number,
 316:   surge: number
 317: ): CardTransform {
 318:   const cardCount = 18;
 319:   switch (formIdx) {
 320:     case 0: {
 321:       // 0: RIFFLE HELIX SHUFFLE (Interlocking dual-helix waves)
 322:       const fanAngle = norm * (0.95 + burst * 0.45) + Math.sin(elapsed * 0.8) * 0.15;
 323:       const radius = (mobileNow ? 2.1 : 2.75) + Math.abs(norm) * 0.65 + burst * 1.1;
 324:       const riffleWave = Math.sin(elapsed * 2.2 + card.phase);
 325:       const burstSpread = burst * Math.sin(card.phase * 2.0) * 2.4;
 326:       return {
 327:         x: Math.sin(fanAngle) * radius + Math.cos(elapsed * 1.6 + card.phase) * 0.32 + burstSpread * 0.5,
 328:         y: Math.cos(fanAngle) * 1.15 - 0.35 + riffleWave * 0.35 + Math.sin(elapsed * 3.2 + i * 0.55) * (0.18 + burst * 0.5),
 329:         z: -Math.abs(norm) * 1.85 + Math.sin(elapsed * 2.4 + card.phase) * 0.65 - burst * 0.8,
 330:         rotX: Math.sin(elapsed * 1.4 + card.phase) * 0.22 + burst * 0.5,
 331:         rotY: -fanAngle * 0.72 + Math.sin(elapsed * 1.9 + card.phase) * 0.38 + burst * Math.PI * 2,
 332:         rotZ: -fanAngle * 0.42 + riffleWave * 0.08,
 333:         scale: mobileNow ? 0.86 : 1.0,
 334:       };
 335:     }
 336:     case 1: {
 337:       // 1: MONOLITH CORRIDOR (Two inward-facing avenue sentinels with click-to-surge warp plunge)
 338:       const corridorSpreadSurge = 1 + surge * 0.22;
 339:       const surgeWave = Math.sin(elapsed * 5.0 + i * 0.5) * surge * 0.75;
 340:       const idleWaveY = Math.sin(elapsed * 1.5 + card.phase) * 0.08;
 341:       const idleWaveRot = Math.sin(elapsed * 1.1 + card.phase) * 0.04;
 342:       return {
 343:         x: card.corridorPos.x * corridorSpreadSurge,
 344:         y: card.corridorPos.y + idleWaveY + surgeWave,
 345:         z: card.corridorPos.z,
 346:         rotX: 0,
 347:         rotY: card.corridorRotY + idleWaveRot,
 348:         rotZ: 0,
 349:         scale: card.corridorScale * (1 + surge * 0.18),
 350:       };
 351:     }
 352:     case 2: {
 353:       // 2: CELESTIAL SOLSTICE WHEEL (360° rotating gyroscopic halo ring)
 354:       const angle = (i / cardCount) * Math.PI * 2 + elapsed * 0.4 + burst * 1.8;
 355:       const wheelRadius = mobileNow ? 2.5 : 3.4;
 356:       const tilt = 0.45;
 357:       const floatY = Math.sin(elapsed * 1.4 + card.phase) * 0.12;
 358:       return {
 359:         x: Math.cos(angle) * wheelRadius,
 360:         y: Math.sin(angle) * wheelRadius * Math.sin(tilt) + floatY - 0.1,
 361:         z: Math.sin(angle) * wheelRadius * Math.cos(tilt) - 1.2,
 362:         rotX: -tilt + Math.sin(elapsed * 1.2 + card.phase) * 0.08,
 363:         rotY: -angle - Math.PI / 2 + Math.sin(elapsed * 1.6 + card.phase) * 0.06,
 364:         rotZ: Math.sin(angle) * 0.2,
 365:         scale: (mobileNow ? 0.82 : 0.96) * (1 + Math.sin(angle) * 0.1),
 366:       };
 367:     }
 368:     case 3: {
 369:       // 3: MASTER DEALER ARCANE FAN (Panoramic croupier spread across the viewing plane)
 370:       const fanSpread = mobileNow ? 1.5 : 1.9;
 371:       const spreadAngle = norm * fanSpread;
 372:       const archRadius = mobileNow ? 3.8 : 4.9;
 373:       const breathing = Math.sin(elapsed * 1.5 + card.phase) * 0.06;
 374:       return {
 375:         x: Math.sin(spreadAngle) * archRadius * 0.88 + Math.cos(elapsed * 1.2 + card.phase) * 0.06,
 376:         y: (Math.cos(spreadAngle) - 1) * archRadius * 0.42 + 0.38 + breathing,
 377:         z: (1 - Math.abs(norm)) * 0.85 - 0.6 - burst * 0.5,
 378:         rotX: 0.26 + Math.abs(norm) * 0.12,
 379:         rotY: -spreadAngle * 0.72 + Math.sin(elapsed * 1.1 + card.phase) * 0.04,
 380:         rotZ: -spreadAngle * 0.88,
 381:         scale: (mobileNow ? 0.9 : 1.06) * (1 - Math.abs(norm) * 0.08),
 382:       };
 383:     }
 384:     case 4:
 385:     default: {
 386:       // 4: VORTEX CYCLONE SPIRE (Ascending double-helix cosmic spire)
 387:       const helixAngle = (i / cardCount) * Math.PI * 4 + elapsed * 0.72 + burst * 1.2;
 388:       const heightFrac = (i - (cardCount - 1) / 2) / (cardCount / 2);
 389:       const helixRadius = (mobileNow ? 1.7 : 2.3) * (1.1 - Math.abs(heightFrac) * 0.25);
 390:       return {
 391:         x: Math.cos(helixAngle) * helixRadius,
 392:         y: heightFrac * 2.6 + Math.sin(elapsed * 2.2 + i * 0.4) * 0.14,
 393:         z: Math.sin(helixAngle) * helixRadius - 1.4,
 394:         rotX: 0.18,
 395:         rotY: -helixAngle + Math.PI / 2,
 396:         rotZ: Math.sin(helixAngle) * 0.25,
 397:         scale: (mobileNow ? 0.78 : 0.94) * (1 + (1 - Math.abs(heightFrac)) * 0.15),
 398:       };
 399:     }
 400:   }
 401: }
