  5: export default function ParallaxBackground() {
  6:   const [scrollY, setScrollY] = useState(0);
  7:   const [pointer, setPointer] = useState({ x: 0, y: 0 });
  8:   const canvasRef = useRef<HTMLCanvasElement>(null);
  9: 
 10:   // Track window scroll and mouse pointer
 11:   useEffect(() => {
 12:     let ticking = false;
 13: 
 14:     const handleScroll = () => {
 15:       if (!ticking) {
 16:         window.requestAnimationFrame(() => {
 17:           setScrollY(window.scrollY);
 18:           ticking = false;
 19:         });
 20:         ticking = true;
 21:       }
 22:     };
 23: 
 24:     const handlePointerMove = (e: MouseEvent) => {
 25:       const nx = (e.clientX / window.innerWidth) * 2 - 1;
 26:       const ny = (e.clientY / window.innerHeight) * 2 - 1;
 27:       setPointer({ x: nx, y: ny });
 28:     };
 29: 
 30:     window.addEventListener("scroll", handleScroll, { passive: true });
 31:     window.addEventListener("mousemove", handlePointerMove, { passive: true });
 32: 
 33:     return () => {
 34:       window.removeEventListener("scroll", handleScroll);
 35:       window.removeEventListener("mousemove", handlePointerMove);
 36:     };
 37:   }, []);
 38: 
 39:   // Ambient floating particle embers on canvas
 40:   useEffect(() => {
 41:     const canvas = canvasRef.current;
 42:     if (!canvas) return;
 43: 
 44:     const ctx = canvas.getContext("2d");
 45:     if (!ctx) return;
 46: 
 47:     let animId = 0;
 48:     const dpr = Math.min(window.devicePixelRatio || 1, 2);
 49: 
 50:     const resize = () => {
 51:       canvas.width = window.innerWidth * dpr;
 52:       canvas.height = window.innerHeight * dpr;
 53:       ctx.scale(dpr, dpr);
 54:     };
 55:     resize();
 56:     window.addEventListener("resize", resize);
 57: 
 58:     const count = 45;
 59:     const particles = Array.from({ length: count }, () => ({
 60:       x: Math.random() * window.innerWidth,
 61:       y: Math.random() * window.innerHeight,
 62:       size: Math.random() * 2 + 1,
 63:       speedY: Math.random() * 0.4 + 0.15,
 64:       speedX: (Math.random() - 0.5) * 0.2,
 65:       opacity: Math.random() * 0.6 + 0.2,
 66:       color: Math.random() > 0.4 ? "#FFAA24" : "#E65C19",
 67:     }));
 68: 
 69:     const render = () => {
 70:       ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
 71: 
 72:       for (const p of particles) {
 73:         p.y -= p.speedY;
 74:         p.x += p.speedX;
 75: 
 76:         // Reset if off top
 77:         if (p.y < -10) {
 78:           p.y = window.innerHeight + 10;
 79:           p.x = Math.random() * window.innerWidth;
 80:         }
 81: 
 82:         ctx.fillStyle = p.color;
 83:         ctx.globalAlpha = p.opacity;
 84:         ctx.beginPath();
 85:         ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
 86:         ctx.fill();
 87:       }
 88: 
 89:       ctx.globalAlpha = 1;
 90:       animId = requestAnimationFrame(render);
 91:     };
 92: 
 93:     render();
 94: 
 95:     return () => {
 96:       cancelAnimationFrame(animId);
 97:       window.removeEventListener("resize", resize);
 98:     };
 99:   }, []);
