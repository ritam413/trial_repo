 381: /* ==========================================================================
 382:    5. MAIN HERO SECTION COMPONENT (With Scroll-Cascading Parallax & Cursor Following)
 383:    ========================================================================== */
 384: interface HeroSectionProps {
 385:   onExploreGallery?: () => void;
 386: }
 387: 
 388: export default function HeroSection({ onExploreGallery }: HeroSectionProps) {
 389:   const heroContainerRef = useRef<HTMLDivElement>(null);
 390:   const mountRef = useRef<HTMLDivElement>(null);
 391: 
 392:   const [heroMode, setHeroMode] = useState<"shuffle" | "corridor">("shuffle");
 393:   const [shuffleCount, setShuffleCount] = useState(1);
 394:   const [webglActive, setWebglActive] = useState(true);
 395:   const [drawnFortune, setDrawnFortune] = useState<Fortune | null>(null);
 396:   const [surgeActive, setSurgeActive] = useState(false);
 397: 
 398:   // GSAP animation & dynamic parallax state
 399:   const animStateRef = useRef({
 400:     introDeal: 0, // Starts at 0, cards fly in from side
 401:     modeBlend: 0, // 0 = 3D Shuffle, 1 = Monolith Corridor
 402:     corridorSurge: 0, // 0 to 1 on clicking monolith corridor
 403:     scrollProgress: 0, // Continuous scroll progress
 404:     heroInfluence: 1, // 1 when at top in hero, 0 when scrolled away
 405:     spadeInfluence: 0, // 1 when viewing "What is Sanskaran" / Archetypes section
 406:     clubInfluence: 0, // 1 when viewing "Gallery / Capabilities" section
 407:     heartInfluence: 0, // 1 when viewing "Genesis Pass / Pre-register" section
 408:     diamondInfluence: 0, // 1 when viewing "New Core Members" section
 409:     shuffleImpulse: 0,
 410:     pointerX: 0,
 411:     pointerY: 0,
 412:   });
 413: 
 414:   // Switch mode smoothly using GSAP
 415:   const handleModeChange = useCallback((newMode: "shuffle" | "corridor") => {
 416:     setHeroMode(newMode);
 417:     const targetBlend = newMode === "corridor" ? 1 : 0;
 418: 
 419:     gsap.to(animStateRef.current, {
 420:       modeBlend: targetBlend,
 421:       duration: 1.4,
 422:       ease: "power2.inOut",
 423:       overwrite: "auto",
 424:     });
 425:   }, []);
 426: 
 427:   // Corridor Warp & Surge Trigger
 428:   const handleTriggerCorridorSurge = useCallback(() => {
 429:     gsap.killTweensOf(animStateRef.current, "corridorSurge");
 430:     setSurgeActive(true);
 431: 
 432:     gsap
 433:       .timeline({
 434:         onComplete: () => setSurgeActive(false),
 435:       })
 436:       .to(animStateRef.current, {
 437:         corridorSurge: 1.0,
 438:         duration: 0.85,
 439:         ease: "power3.in",
 440:       })
 441:       .to(animStateRef.current, {
 442:         corridorSurge: 0.0,
 443:         duration: 1.4,
 444:         ease: "power3.out",
 445:       });
 446:   }, []);
 447: 
 448:   const handleShuffleBurst = useCallback(() => {
 449:     gsap.killTweensOf(animStateRef.current, "shuffleImpulse");
 450:     animStateRef.current.shuffleImpulse = 1.0;
 451:     gsap.to(animStateRef.current, {
 452:       shuffleImpulse: 0,
 453:       duration: 1.2,
 454:       ease: "power2.out",
 455:     });
 456:     setShuffleCount((c) => c + 1);
 457:   }, []);
 458: 
 459:   const handleDrawFortune = useCallback(() => {
 460:     handleShuffleBurst();
 461:     const pick = DESTINY_FORTUNES[Math.floor(Math.random() * DESTINY_FORTUNES.length)];
 462:     setDrawnFortune(pick);
 463:   }, [handleShuffleBurst]);
 464: 
 465:   const handleHeroClick = (e: React.MouseEvent<HTMLDivElement>) => {
 466:     const target = e.target as HTMLElement;
 467:     if (target.closest("button") || target.closest("input")) return;
 468: 
 469:     if (animStateRef.current.modeBlend > 0.4) {
 470:       handleTriggerCorridorSurge();
 471:     }
 472:   };
 473: 
 474:   // INITIAL LOAD ANIMATION SEQUENCE:
 475:   // 1. Cards fly in from the side into 3D shuffle
 476:   // 2. Stay in 3D shuffle position for 1 second
 477:   // 3. Converts to monolith corridor
 478:   useEffect(() => {
 479:     const introTl = gsap.timeline({ delay: 0.2 });
 480: 
 481:     introTl
 482:       .to(animStateRef.current, {
 483:         introDeal: 1.0,
 484:         duration: 1.2,
 485:         ease: "power3.out",
 486:       })
 487:       .to({}, { duration: 1.0 }) // Stay in 3D shuffle for 1.0s
 488:       .to(animStateRef.current, {
 489:         modeBlend: 1.0,
 490:         duration: 1.6,
 491:         ease: "power2.inOut",
 492:         onStart: () => setHeroMode("corridor"),
 493:       });
 494: 
 495:     return () => {
 496:       introTl.kill();
 497:     };
 498:   }, []);
 499: 
 500:   // Continuous Window Scroll Listener & Section Spotlight Coordinator
 501:   useEffect(() => {
 502:     const calcSectionInfluence = (elementId: string, windowH: number) => {
 503:       const el = document.getElementById(elementId);
 504:       if (!el) return 0;
 505:       const rect = el.getBoundingClientRect();
 506:       // Target viewing center: when the section header is in the active reading area
 507:       const headerCenter = rect.top + Math.min(rect.height, windowH) * 0.35;
 508:       const viewCenter = windowH * 0.45;
 509:       const dist = Math.abs(headerCenter - viewCenter) / (windowH * 0.65);
 510:       const raw = THREE.MathUtils.clamp(1 - dist, 0, 1);
 511:       return raw * raw * (3 - 2 * raw); // smoothstep
 512:     };
 513: 
 514:     const onScroll = () => {
 515:       const scrollY = window.scrollY || document.documentElement.scrollTop;
 516:       const windowH = window.innerHeight || 800;
 517: 
 518:       // 1. Hero influence: 1 at top, fades to 0 as user scrolls past hero
 519:       const heroInf = THREE.MathUtils.clamp(1 - scrollY / (windowH * 0.72), 0, 1);
 520:       animStateRef.current.heroInfluence = heroInf * heroInf * (3 - 2 * heroInf);
 521: 
 522:       // 2. Section "cards" (What is Sanskaran / Archetypes) -> Summons ONLY the Spade card!
 523:       animStateRef.current.spadeInfluence = calcSectionInfluence("cards", windowH);
 524: 
 525:       // 3. Section "about" (Gallery / Conclave Capabilities) -> Summons ONLY the Club card!
 526:       animStateRef.current.clubInfluence = calcSectionInfluence("about", windowH);
 527: 
 528:       // 4. Section "pre-register" (Genesis Pass Deck) -> Summons Heart card
 529:       animStateRef.current.heartInfluence = calcSectionInfluence("pre-register", windowH);
 530: 
 531:       // 5. Section "core-members" (New Core Members / Diamond Court) -> Summons Diamond card
 532:       animStateRef.current.diamondInfluence = calcSectionInfluence("core-members", windowH);
 533: 
 534:       animStateRef.current.scrollProgress = scrollY / windowH;
 535:     };
 536: 
 537:     window.addEventListener("scroll", onScroll, { passive: true });
 538:     onScroll();
 539:     return () => window.removeEventListener("scroll", onScroll);
 540:   }, []);
 541: 
 542:   // Global Pointer/Mouse Tracking across the entire window
 543:   useEffect(() => {
 544:     const handleGlobalPointerMove = (e: MouseEvent) => {
 545:       const nx = (e.clientX / window.innerWidth) * 2 - 1;
 546:       const ny = -((e.clientY / window.innerHeight) * 2 - 1);
 547:       animStateRef.current.pointerX = nx;
 548:       animStateRef.current.pointerY = ny;
 549:     };
 550: 
 551:     window.addEventListener("mousemove", handleGlobalPointerMove, { passive: true });
 552:     return () => window.removeEventListener("mousemove", handleGlobalPointerMove);
 553:   }, []);
 554: 
 555:   // ScrollTrigger to guarantee corridor mode is engaged when user scrolls down
 556:   useEffect(() => {
 557:     if (!heroContainerRef.current) return;
 558: 
 559:     const ctx = gsap.context(() => {
 560:       ScrollTrigger.create({
 561:         trigger: heroContainerRef.current,
 562:         start: "top top",
 563:         end: "+=80%",
 564:         onLeave: () => {
 565:           if (animStateRef.current.modeBlend < 1) {
 566:             gsap.to(animStateRef.current, { modeBlend: 1.0, duration: 0.8, ease: "power2.out" });
 567:             setHeroMode("corridor");
 568:           }
 569:         },
 570:       });
 571:     }, heroContainerRef);
 572: 
 573:     return () => ctx.revert();
 574:   }, []);
 575: 
 576:   // Three.js Scene Setup & Loop
 577:   useEffect(() => {
 578:     const container = mountRef.current;
 579:     if (!container) return;
 580: 
 581:     let animationFrameId = 0;
 582:     let renderer: THREE.WebGLRenderer | null = null;
 583:     let cardGeo: THREE.BoxGeometry | null = null;
 584:     let floorGeo: THREE.PlaneGeometry | null = null;
 585:     let particleGeo: THREE.BufferGeometry | null = null;
 586:     let backTexture: THREE.CanvasTexture | null = null;
 587:     let faceTextures: THREE.CanvasTexture[] = [];
 588: 
 589:     const width = window.innerWidth;
 590:     const height = window.innerHeight;
 591:     const isMobile = width < 640;
 592: 
 593:     const scene = new THREE.Scene();
 594:     // Transparent scene background so ParallaxBackground shows through seamlessly
 595:     const fog = new THREE.FogExp2("#140E17", 0.022);
 596:     scene.fog = fog;
 597: 
 598:     const camera = new THREE.PerspectiveCamera(isMobile ? 56 : 44, width / height, 0.1, 100);
 599:     camera.position.set(0, 0.3, isMobile ? 10.6 : 8.2);
 600: 
 601:     const handleResize = () => {
 602:       if (!renderer) return;
 603:       const w = window.innerWidth;
 604:       const h = window.innerHeight;
 605:       camera.aspect = w / h;
 606:       camera.fov = w < 640 ? 56 : 44;
 607:       camera.updateProjectionMatrix();
 608:       renderer.setSize(w, h);
 609:     };
 610: 
 611:     try {
 612:       renderer = new THREE.WebGLRenderer({
 613:         antialias: true,
 614:         alpha: true,
 615:         powerPreference: "high-performance",
 616:       });
 617:       renderer.setClearColor(0x000000, 0);
 618:       renderer.setSize(width, height);
 619:       renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
 620:       renderer.toneMapping = THREE.ACESFilmicToneMapping;
 621:       renderer.toneMappingExposure = 1.25;
 622:       container.appendChild(renderer.domElement);
 623:       setWebglActive(true);
 624: 
 625:       // Lighting
 626:       const ambientLight = new THREE.AmbientLight("#FFF4E0", 0.65);
 627:       scene.add(ambientLight);
 628: 
 629:       const solarFlareLight = new THREE.PointLight("#FFAA24", 5.0, 38);
 630:       solarFlareLight.position.set(0, 3.6, 4.5);
 631:       scene.add(solarFlareLight);
 632: 
 633:       const horizonBacklight = new THREE.PointLight("#FFAA24", 7.5, 48);
 634:       horizonBacklight.position.set(0, 2.5, -16);
 635:       scene.add(horizonBacklight);
 636: 
 637:       const amberFill = new THREE.PointLight("#E65C19", 4.0, 28);
 638:       amberFill.position.set(-5, -1.5, 3);
 639:       scene.add(amberFill);
 640: 
 641:       const crimsonRim = new THREE.PointLight("#8B1E24", 4.5, 28);
 642:       crimsonRim.position.set(5, 2, -2);
 643:       scene.add(crimsonRim);
 644: 
 645:       // Floor
 646:       floorGeo = new THREE.PlaneGeometry(60, 80);
 647:       const floorMat = new THREE.MeshStandardMaterial({
 648:         color: "#0B0B0D",
 649:         roughness: 0.35,
 650:         metalness: 0.72,
 651:         transparent: true,
 652:         opacity: 0.28,
 653:       });
 654:       const floorMesh = new THREE.Mesh(floorGeo, floorMat);
 655:       floorMesh.rotation.x = -Math.PI / 2;
 656:       floorMesh.position.y = -3.8;
 657:       scene.add(floorMesh);
 658: 
 659:       // Procedural Textures
 660:       backTexture = createCardBackTexture();
 661:       const specs: Array<{ rank: string; suit: string; stock: "ivory" | "obsidian" }> = [
 662:         { rank: "A", suit: "♠", stock: "ivory" },
 663:         { rank: "A", suit: "♣", stock: "ivory" },
 664:         { rank: "K", suit: "♥", stock: "ivory" },
 665:         { rank: "Q", suit: "♦", stock: "ivory" },
 666:         { rank: "10", suit: "♦", stock: "ivory" },
 667:         { rank: "A", suit: "♠", stock: "obsidian" },
 668:       ];
 669:       faceTextures = specs.map((s) => createCardFaceTexture(s.rank, s.suit, s.stock));
 670: 
 671:       const CARD_COUNT = 18;
 672:       cardGeo = new THREE.BoxGeometry(1.65, 2.48, 0.028);
 673: 
 674:       const edgeMat = new THREE.MeshStandardMaterial({
 675:         color: "#FFAA24",
 676:         emissive: "#8B1E24",
 677:         emissiveIntensity: 0.35,
 678:         roughness: 0.3,
 679:         metalness: 0.8,
 680:       });
 681:       const backMat = new THREE.MeshStandardMaterial({
 682:         map: backTexture,
 683:         roughness: 0.35,
 684:         metalness: 0.22,
 685:       });
 686: 
 687:       const corridorSpots = [
 688:         { x: -2.15, z: 2.1, rotY: 0.28, scale: 1.76 },
 689:         { x: 2.15, z: 1.5, rotY: -0.32, scale: 1.82 },
 690:         { x: -1.15, z: -1.4, rotY: 0.16, scale: 1.68 },
 691:         { x: 2.75, z: -2.0, rotY: -0.25, scale: 1.72 },
 692:         { x: -2.85, z: -3.4, rotY: 0.38, scale: 1.65 },
 693:         { x: 0.85, z: -4.8, rotY: -0.14, scale: 1.6 },
 694:         { x: -1.65, z: -6.5, rotY: 0.22, scale: 1.58 },
 695:         { x: 1.95, z: -7.8, rotY: -0.2, scale: 1.62 },
 696:         { x: -0.35, z: -9.5, rotY: 0.08, scale: 1.55 },
 697:       ];
 698: 
 699:       const cards: Array<{
 700:         mesh: THREE.Mesh;
 701:         corridorPos: THREE.Vector3;
 702:         corridorRotY: number;
 703:         corridorScale: number;
 704:         phase: number;
 705:       }> = [];
 706: 
 707:       for (let i = 0; i < CARD_COUNT; i++) {
 708:         const frontMat = new THREE.MeshStandardMaterial({
 709:           map: faceTextures[i % faceTextures.length],
 710:           roughness: 0.32,
 711:           metalness: 0.18,
 712:         });
 713:         const mesh = new THREE.Mesh(cardGeo, [edgeMat, edgeMat, edgeMat, edgeMat, frontMat, backMat]);
 714:         scene.add(mesh);
 715: 
 716:         const spot = corridorSpots[i % corridorSpots.length];
 717:         const tier = Math.floor(i / corridorSpots.length);
 718:         cards.push({
 719:           mesh,
 720:           corridorPos: new THREE.Vector3(
 721:             spot.x * (tier === 0 ? 1 : 1.15),
 722:             -0.45 + (spot.scale - 1.6) * 1.1,
 723:             spot.z - tier * 10.5
 724:           ),
 725:           corridorRotY: spot.rotY,
 726:           corridorScale: spot.scale,
 727:           phase: (i / CARD_COUNT) * Math.PI * 2,
 728:         });
 729:       }
 730: 
 731:       // Embers
 732:       const particleCount = 180;
 733:       particleGeo = new THREE.BufferGeometry();
 734:       const positions = new Float32Array(particleCount * 3);
 735:       for (let i = 0; i < particleCount; i++) {
 736:         positions[i * 3] = (Math.random() - 0.5) * 18;
 737:         positions[i * 3 + 1] = (Math.random() - 0.5) * 12;
 738:         positions[i * 3 + 2] = (Math.random() - 0.5) * 24;
 739:       }
 740:       particleGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
 741: 
 742:       const particleMat = new THREE.PointsMaterial({
 743:         color: "#FFAA24",
 744:         size: 0.08,
 745:         transparent: true,
 746:         opacity: 0.85,
 747:         blending: THREE.AdditiveBlending,
 748:       });
 749:       const embers = new THREE.Points(particleGeo, particleMat);
 750:       scene.add(embers);
 751: 
 752:       window.addEventListener("resize", handleResize);
 753: 
 754:       const clock = new THREE.Clock();
 755:       const targetPos = new THREE.Vector3();
 756:       const targetScaleVec = new THREE.Vector3();
 757: 
 758:       const animateLoop = () => {
 759:         animationFrameId = requestAnimationFrame(animateLoop);
 760:         if (!renderer) return;
 761: 
 762:         const dt = Math.min(clock.getDelta(), 0.05);
 763:         const elapsed = clock.getElapsedTime();
 764: 
 765:         const deal = animStateRef.current.introDeal; // 0 to 1
 766:         const modeBlend = animStateRef.current.modeBlend; // 0 to 1
 767:         const burst = animStateRef.current.shuffleImpulse;
 768:         const surge = animStateRef.current.corridorSurge; // 0 to 1
 769:         const scroll = animStateRef.current.scrollProgress; // 0 to 1+
 770: 
 771:         // Fog
 772:         const shuffleFog = new THREE.Color("#140E17");
 773:         const corridorFog = new THREE.Color(surge > 0.3 ? "#A84C0F" : "#8A420E");
 774:         fog.color.lerpColors(shuffleFog, corridorFog, modeBlend);
 775:         fog.density = THREE.MathUtils.lerp(0.032, 0.072 + surge * 0.02, modeBlend);
 776: 
 777:         floorMesh.position.y = THREE.MathUtils.lerp(-4.5, -3.2 - scroll * 5.0, modeBlend);
 778: 
 779:         // Camera Dynamics:
 780:         const mobileNow = (window.innerWidth) < 640;
 781:         const baseZ = THREE.MathUtils.lerp(mobileNow ? 10.6 : 8.1, mobileNow ? 7.8 : 6.4, modeBlend);
 782:         const surgeZPlunge = surge * 7.5;
 783: 
 784:         // Camera smoothly follows mouse pointer with depth lerp & vertical scroll tracking
 785:         const scrollCamY = -scroll * 0.8;
 786:         const targetCamX = animStateRef.current.pointerX * (mobileNow ? 0.55 : 0.95);
 787:         const targetCamY = THREE.MathUtils.lerp(0.35, -0.22, modeBlend) + scrollCamY + animStateRef.current.pointerY * 0.45;
 788: 
 789:         camera.position.x += (targetCamX - camera.position.x) * 0.06;
 790:         camera.position.y += (targetCamY - camera.position.y) * 0.06;
 791:         camera.position.z += (baseZ - surgeZPlunge - camera.position.z) * (surge > 0.1 ? 0.12 : 0.06);
 792:         camera.lookAt(0, THREE.MathUtils.lerp(0.1, -0.3, modeBlend) + scrollCamY, THREE.MathUtils.lerp(0, -10, modeBlend));
 793: 
 794:         // Light Surges
 795:         horizonBacklight.intensity = 7.5 + surge * 18.0;
 796:         solarFlareLight.intensity = 5.0 + surge * 5.0;
 797:         edgeMat.emissiveIntensity = 0.5 + surge * 2.5;
 798: 
 799:         // SECTION COORDINATION WEIGHTS:
 800:         const heroInf = animStateRef.current.heroInfluence;   // 1 in hero, 0 outside
 801:         const spadeInf = animStateRef.current.spadeInfluence; // 1 in Sanskaran Archetypes section
 802:         const clubInf = animStateRef.current.clubInfluence;   // 1 in Gallery / Capabilities section
 803:         const heartInf = animStateRef.current.heartInfluence; // 1 in Pre-register / Pass section
 804:         const diamondInf = animStateRef.current.diamondInfluence; // 1 in Core Members section
 805: 
 806:         // Animate each card
 807:         for (let i = 0; i < CARD_COUNT; i++) {
 808:           const card = cards[i];
 809:           const norm = (i - (CARD_COUNT - 1) / 2) / (CARD_COUNT / 2);
 810: 
 811:           const riffleWave = Math.sin(elapsed * 2.2 + card.phase);
 812:           const burstSpread = burst * Math.sin(card.phase * 2.0) * 2.4;
 813:           const fanAngle = norm * (0.95 + burst * 0.45) + Math.sin(elapsed * 0.8) * 0.15;
 814:           const radius = (mobileNow ? 2.1 : 2.75) + Math.abs(norm) * 0.65 + burst * 1.1;
 815: 
 816:           // Staggered per-card side deal so EVERY card flies in from the side sequentially:
 817:           const cardDealStagger = (i / CARD_COUNT) * 0.45;
 818:           const cardDealRaw = THREE.MathUtils.clamp((deal - cardDealStagger) / (1 - 0.45), 0, 1);
 819:           const cardDealEased = cardDealRaw * cardDealRaw * (3 - 2 * cardDealRaw);
 820:           const sideFlyX = (i % 2 === 0 ? -26 : 26) * (1 - cardDealEased) + (i - 9) * 0.4 * (1 - cardDealEased);
 821:           const sideFlyRotZ = (i % 2 === 0 ? -2.2 : 2.2) * (1 - cardDealEased);
 822:           const sideFlyRotY = (i % 2 === 0 ? 2.8 : -2.8) * (1 - cardDealEased);
 823: 
 824:           // 3D Shuffle Position
 825:           const shuffleX = Math.sin(fanAngle) * radius + Math.cos(elapsed * 1.6 + card.phase) * 0.32 + burstSpread * 0.5 + sideFlyX;
 826:           const shuffleY =
 827:             Math.cos(fanAngle) * 1.15 -
 828:             0.35 +
 829:             riffleWave * 0.35 +
 830:             Math.sin(elapsed * 3.2 + i * 0.55) * (0.18 + burst * 0.5);
 831:           const shuffleZ = -Math.abs(norm) * 1.85 + Math.sin(elapsed * 2.4 + card.phase) * 0.65 - burst * 0.8;
 832: 
 833:           const shuffleRotX = Math.sin(elapsed * 1.4 + card.phase) * 0.22 + burst * 0.5;
 834:           const shuffleRotY = -fanAngle * 0.72 + Math.sin(elapsed * 1.9 + card.phase) * 0.38 + burst * Math.PI * 2 + sideFlyRotY;
 835:           const shuffleRotZ = -fanAngle * 0.42 + riffleWave * 0.08 + sideFlyRotZ;
 836: 
 837:           // Base Monolith Corridor Position with Surge Plunge & Idle Wave
 838:           const corridorSpreadSurge = 1 + surge * 0.22;
 839:           const surgeWave = Math.sin(elapsed * 5.0 + i * 0.5) * surge * 0.75;
 840:           const idleWaveY = Math.sin(elapsed * 1.5 + card.phase) * 0.08;
 841:           const idleWaveRot = Math.sin(elapsed * 1.1 + card.phase) * 0.04;
 842: 
 843:           const heroCorridorX = card.corridorPos.x * corridorSpreadSurge;
 844:           const heroCorridorY = card.corridorPos.y + idleWaveY + surgeWave;
 845:           const heroCorridorZ = card.corridorPos.z;
 846: 
 847:           // In-Hero Position (interpolates between 3D Shuffle and Monolith Corridor)
