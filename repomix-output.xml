 56:     window.addEventListener("resize", resize);
 57: 
 58:     const count = 45;
 59:     const particles = Array.from({ length: count }, () => ({
 60:       x: Math.random() * window.innerWidth,
 61:       y: Math.random() * window.innerHeight,
 62:       size: Math.random() * 2 + 1,
 63:       speedY: Math.random() * 0.4 + 0.15,
 64:       speedX: (Math.random() - 0.5) * 0.2,
 65:       opacity: Math.random() * 0.6 + 0.2,
 66:       color: Math.random() > 0.4 ? "#FFAA24" : "#E65C19",
 67:     }));
 68: 
 69:     const render = () => {
 70:       ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
 71: 
 72:       for (const p of particles) {
 73:         p.y -= p.speedY;
 74:         p.x += p.speedX;
 75: 
 76:         // Reset if off top
 77:         if (p.y < -10) {
 78:           p.y = window.innerHeight + 10;
 79:           p.x = Math.random() * window.innerWidth;
 80:         }
 81: 
 82:         ctx.fillStyle = p.color;
 83:         ctx.globalAlpha = p.opacity;
 84:         ctx.beginPath();
 85:         ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
 86:         ctx.fill();
 87:       }
 88: 
 89:       ctx.globalAlpha = 1;
 90:       animId = requestAnimationFrame(render);
 91:     };
 92: 
 93:     render();
 94: 
 95:     return () => {
 96:       cancelAnimationFrame(animId);
 97:       window.removeEventListener("resize", resize);
 98:     };
