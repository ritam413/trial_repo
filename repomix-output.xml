120: function TactileRealmCard({
121:   rank,
122:   suit,
123:   title,
124:   tagline,
125:   leadParagraph,
126: 
127:   theme,
128:   onInspect,
129: }: TactileRealmCardProps) {
130:   const cardRef = useRef<HTMLDivElement>(null);
131:   const [rotateX, setRotateX] = useState(0);
132:   const [rotateY, setRotateY] = useState(0);
133:   const [glarePos, setGlarePos] = useState({ x: 50, y: 50, opacity: 0 });
134: 
135:   const handlePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {
136:     const el = cardRef.current;
137:     if (!el) return;
138:     const rect = el.getBoundingClientRect();
139:     const x = e.clientX - rect.left;
140:     const y = e.clientY - rect.top;
141: 
142:     const normX = (x / rect.width) * 2 - 1; // -1 to 1
143:     const normY = (y / rect.height) * 2 - 1; // -1 to 1
144: 
145:     // Subtle 3D tilt (max 8 degrees for controlled elegance)
146:     setRotateX(-normY * 8);
147:     setRotateY(normX * 8);
148:     setGlarePos({
149:       x: (x / rect.width) * 100,
150:       y: (y / rect.height) * 100,
151:       opacity: 0.22,
152:     });
153:   };
154: 
155:   const handlePointerLeave = () => {
156:     setRotateX(0);
157:     setRotateY(0);
158:     setGlarePos((prev) => ({ ...prev, opacity: 0 }));
159:   };
160: 
161:   return (
162:     <div
163:       style={{ perspective: 1200 }}
164:       className="w-full"
165:     >
166:       <div
167:         ref={cardRef}
168:         onPointerMove={handlePointerMove}
169:         onPointerLeave={handlePointerLeave}
170:         style={{
171:           transform: `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`,
172:           transition: "transform 0.22s cubic-bezier(0.22, 1, 0.36, 1)",
173:           transformStyle: "preserve-3d",
174:         }}
175:         className={`relative overflow-hidden rounded-3xl ${theme.bg} ${theme.border} p-6 sm:p-9 shadow-2xl transition-all duration-300 group`}
176:       >
177:         {/* Dynamic Specular Glare Layer */}
178:         <div
179:           aria-hidden="true"
180:           style={{
181:             background: `radial-gradient(circle 320px at ${glarePos.x}% ${glarePos.y}%, rgba(255, 244, 224, ${glarePos.opacity}), transparent 75%)`,
182:             transition: "opacity 0.2s ease-out",
183:           }}
184:           className="absolute inset-0 z-30 pointer-events-none"
185:         />
186: 
187:         {/* Textured Playing Card Micro-Grid Pattern */}
188:         <div
189:           aria-hidden="true"
190:           className="absolute inset-0 opacity-[0.06] pointer-events-none"
191:           style={{
192:             backgroundImage: `radial-gradient(${theme.cornerColor} 1px, transparent 1px)`,
193:             backgroundSize: "16px 16px",
194:           }}
195:         />
196: 
197:         {/* Massive Translucent Playing Card Suit Watermark */}
198:         <span
199:           aria-hidden="true"
200:           style={{ transform: "translateZ(10px)" }}
201:           className={`absolute -right-4 -bottom-10 font-serif text-[12rem] sm:text-[14rem] leading-none ${theme.watermarkColor} select-none pointer-events-none transition-transform duration-500 group-hover:scale-105`}
202:         >
203:           {suit}
204:         </span>
205: 
206:         {/* Card Content in 3D Space */}
207:         <div style={{ transform: "translateZ(24px)" }} className="relative z-10 flex flex-col justify-between h-full">
208:           <div>
209:             {/* Top Corner Index */}
210:             <div className="flex items-center justify-end mb-4">
211:               <div className="flex items-baseline gap-1 text-right">
212:                 <span className={`font-display text-3xl sm:text-4xl leading-none ${theme.cornerColor}`}>
213:                   {rank}
