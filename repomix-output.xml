276:     const ny = ((e.clientY - rect.top) / rect.height) * 2 - 1;
277:     setTilt({ rx: -ny * 8, ry: nx * 8 });
278:   };
279: 
280:   const handlePointerLeave = () => {
281:     setTilt({ rx: 0, ry: 0 });
282:   };
283: 
284:   return (
285:     <button
286:       type="button"
287:       onClick={() => onOpen(item)}
288:       onPointerMove={handlePointerMove}
289:       onPointerLeave={handlePointerLeave}
