374: export default function GallerySection() {
375:   const containerRef = useRef<HTMLDivElement>(null);
376:   const row0Ref = useRef<HTMLDivElement>(null);
377:   const row1Ref = useRef<HTMLDivElement>(null);
378:   const row2Ref = useRef<HTMLDivElement>(null);
379:   const tweensRef = useRef<gsap.core.Tween[]>([]);
380: 
381:   const [selectedMedia, setSelectedMedia] = useState<GalleryItem | null>(null);
382:   const [lightboxMuted, setLightboxMuted] = useState<boolean>(false);
383: 
384:   // Group items into 3 rows
385:   const rows = useMemo(() => {
386:     return [
387:       GALLERY_ITEMS.filter((i) => i.row === 0),
388:       GALLERY_ITEMS.filter((i) => i.row === 1),
389:       GALLERY_ITEMS.filter((i) => i.row === 2),
390:     ];
391:   }, []);
392: 
393:   // Duplicate items 4x per row so -50% translation provides a completely seamless, infinite loop
394:   const repeatedRow0 = useMemo(() => [...rows[0], ...rows[0], ...rows[0], ...rows[0]], [rows]);
395:   const repeatedRow1 = useMemo(() => [...rows[1], ...rows[1], ...rows[1], ...rows[1]], [rows]);
396:   const repeatedRow2 = useMemo(() => [...rows[2], ...rows[2], ...rows[2], ...rows[2]], [rows]);
397: 
398:   // CONTINUOUS AUTONOMOUS GSAP MARQUEE:
399:   // Completely independent of page scroll position!
400:   // Row 0 & 2 glide Left, Row 1 glides Right with independent speeds
401:   useGSAP(
402:     () => {
403:       // Clean up previous tweens before recreating
404:       tweensRef.current.forEach((t) => t.kill());
405:       tweensRef.current = [];
406: 
407:       if (!row0Ref.current || !row1Ref.current || !row2Ref.current) return;
408: 
409:       // Set initial starting positions
410:       gsap.set(row0Ref.current, { xPercent: 0 });
411:       gsap.set(row1Ref.current, { xPercent: -50 });
412:       gsap.set(row2Ref.current, { xPercent: 0 });
413: 
414:       // Row 0: Continuous flow Left
415:       const t0 = gsap.to(row0Ref.current, {
416:         xPercent: -50,
417:         duration: 38,
418:         ease: "none",
419:         repeat: -1,
420:       });
421: 
422:       // Row 1: Continuous flow Right (contra-flow)
423:       const t1 = gsap.fromTo(
424:         row1Ref.current,
425:         { xPercent: -50 },
426:         { xPercent: 0, duration: 44, ease: "none", repeat: -1 }
427:       );
428: 
429:       // Row 2: Continuous flow Left
430:       const t2 = gsap.to(row2Ref.current, {
431:         xPercent: -50,
432:         duration: 32,
433:         ease: "none",
434:         repeat: -1,
435:       });
436: 
437:       tweensRef.current = [t0, t1, t2];
438: 
439:       return () => {
440:         t0.kill();
441:         t1.kill();
442:         t2.kill();
443:       };
444:     },
445:     { scope: containerRef }
446:   );
447: 
448:   // Soft hover velocity dampening so users can comfortably click cards
449:   const handleMouseEnter = useCallback(() => {
450:     tweensRef.current.forEach((t) => {
451:       gsap.to(t, { timeScale: 0.25, duration: 0.4 });
452:     });
453:   }, []);
454: 
455:   const handleMouseLeave = useCallback(() => {
456:     tweensRef.current.forEach((t) => {
457:       gsap.to(t, { timeScale: 1.0, duration: 0.4 });
458:     });
459:   }, []);
460: 
461:   return (
462:     <section
463:       id="gallery"
464:       ref={containerRef}
465:       className="relative py-20 sm:py-28 overflow-hidden z-10 bg-[#120E15] border-b border-[#8B1E24]/40"
466:     >
467:       {/* 3D Ambient Studio Grid Background */}
468:       <div
469:         aria-hidden="true"
470:         className="absolute inset-0 pointer-events-none opacity-[0.06]"
471:         style={{
472:           backgroundImage: `radial-gradient(#FFAA24 1px, transparent 1px)`,
473:           backgroundSize: "28px 28px",
474:         }}
475:       />
476: 
477:       {/* Header Container */}
478:       <div className="max-w-7xl mx-auto px-4 sm:px-8 mb-10 sm:mb-14 relative z-10">
479:         <div className="max-w-2xl">
480:          
481: 
482:           <h2 className="font-display text-4xl sm:text-6xl lg:text-7xl text-[#FFF4E0] leading-none uppercase tracking-tight">
483:             GALLERY{" "}
484:             <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#FFAA24] via-[#E65C19] to-[#FFF4E0]">
485:               SECTION
486:             </span>
487:           </h2>
488: 
489:           <p className="mt-3 font-tech text-xs sm:text-sm text-[#FFF4E0]/75 leading-relaxed">
490:             Experience the visual realm through 3 continuous spread rows flowing autonomously at independent speeds, completely free of scroll position.
491:           </p>
492:         </div>
493:       </div>
494: 
495:       {/* ====================================================================
496:           FULL-WIDTH EDGE-TO-EDGE SPREAD ROWS (100% SCREEN VIEWPORT)
497:           ==================================================================== */}
498:       <div
499:         onMouseEnter={handleMouseEnter}
500:         onMouseLeave={handleMouseLeave}
501:         className="relative w-full overflow-hidden"
502:       >
503:         {/* Subtle Edge Vignettes to elegantly blend cards into screen edges */}
504:         <div
505:           aria-hidden="true"
506:           className="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-28 bg-gradient-to-r from-[#120E15] to-transparent z-20"
507:         />
508:         <div
509:           aria-hidden="true"
510:           className="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-28 bg-gradient-to-l from-[#120E15] to-transparent z-20"
511:         />
512: 
513:         <div className="space-y-4 sm:space-y-6 overflow-hidden py-3">
514:           {/* ROW 0: Continuous Flow Left */}
515:           {rows[0].length > 0 && (
516:             <div className="w-full overflow-hidden">
517:               <div
518:                 ref={row0Ref}
519:                 className="flex items-center gap-3.5 sm:gap-5 px-4 w-max will-change-transform"
520:               >
521:                 {repeatedRow0.map((item, idx) => (
522:                   <SpreadRowMediaTile
523:                     key={`r0-${item.id}-${idx}`}
524:                     item={item}
525:                     onOpen={setSelectedMedia}
526:                   />
527:                 ))}
528:               </div>
529:             </div>
530:           )}
531: 
532:           {/* ROW 1: Continuous Flow Right (Contra-Flow) */}
533:           {rows[1].length > 0 && (
534:             <div className="w-full overflow-hidden">
535:               <div
536:                 ref={row1Ref}
537:                 className="flex items-center gap-3.5 sm:gap-5 px-4 w-max will-change-transform"
538:               >
539:                 {repeatedRow1.map((item, idx) => (
540:                   <SpreadRowMediaTile
541:                     key={`r1-${item.id}-${idx}`}
542:                     item={item}
543:                     onOpen={setSelectedMedia}
544:                   />
545:                 ))}
546:               </div>
547:             </div>
548:           )}
549: 
550:           {/* ROW 2: Continuous Flow Left */}
551:           {rows[2].length > 0 && (
552:             <div className="w-full overflow-hidden">
553:               <div
554:                 ref={row2Ref}
555:                 className="flex items-center gap-3.5 sm:gap-5 px-4 w-max will-change-transform"
556:               >
557:                 {repeatedRow2.map((item, idx) => (
558:                   <SpreadRowMediaTile
